{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Warning"
    }
  },
  "AllowedHosts": "*",
  "RateLimit": {
    "PermitPerSecond": 200
  },
  "ReverseProxy": {
    "Routes": {
      "entries": {
        "ClusterId": "entries",
        "Match": {
          "Path": "/v1/entries/{**rest}"
        }
      },
      "balances": {
        "ClusterId": "consolidation",
        "Match": {
          "Path": "/v1/balances/{**rest}"
        }
      },
      "assistant": {
        "ClusterId": "assistant",
        "Match": {
          "Path": "/v1/assistant/{**rest}"
        }
      }
    },
    "Clusters": {
      "entries": {
        "Destinations": {
          "primary": {
            "Address": "http://entries/"
          }
        },
        "HttpRequest": {
          "ActivityTimeout": "00:00:05"
        }
      },
      "consolidation": {
        "Destinations": {
          "primary": {
            "Address": "http://consolidation/"
          }
        },
        "HttpRequest": {
          "ActivityTimeout": "00:00:05"
        }
      },
      "assistant": {
        "Destinations": {
          "primary": {
            "Address": "http://assistant/"
          }
        },
        "HttpRequest": {
          "ActivityTimeout": "00:00:08"
        }
      }
    }
  }
}
