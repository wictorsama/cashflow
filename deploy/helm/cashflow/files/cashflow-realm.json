{
  "realm": "cashflow",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "accessTokenLifespan": 300,
  "bruteForceProtected": true,
  "clientScopes": [
    {
      "name": "entries:write",
      "description": "Register and reverse entries",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      }
    },
    {
      "name": "entries:read",
      "description": "Read entries",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      }
    },
    {
      "name": "balances:read",
      "description": "Read consolidated balances",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      }
    },
    {
      "name": "balances:rebuild",
      "description": "Rebuild balances from the event log (administrative)",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      }
    },
    {
      "name": "entries:reconcile",
      "description": "Read the totals of every merchant (reconciliation job only)",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      }
    },
    {
      "name": "assistant:draft",
      "description": "Ask the assistant for an entry draft (it never records anything)",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      }
    },
    {
      "name": "entries:audit",
      "description": "Read the entries of the merchants assigned to the auditor (read-only)",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      }
    },
    {
      "name": "balances:audit",
      "description": "Read the balances of the merchants assigned to the auditor (read-only)",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      }
    },
    {
      "name": "cashflow-claims",
      "description": "Subject, audience and merchant claims required by the Cash Flow APIs",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "false",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": [
        {
          "name": "subject",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-sub-mapper",
          "config": {
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "cashflow-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "cashflow-api",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "merchant-id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "config": {
            "user.attribute": "merchant_id",
            "claim.name": "merchant_id",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.claim": "false",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "audit-merchants",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "config": {
            "user.attribute": "audit_merchants",
            "claim.name": "audit_merchants",
            "jsonType.label": "String",
            "multivalued": "true",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.claim": "false",
            "introspection.token.claim": "true"
          }
        }
      ]
    }
  ],
  "clients": [
    {
      "clientId": "cashflow-web",
      "name": "Cash Flow web application (users sign in with authorization code + PKCE)",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "http://localhost:3000/*"
      ],
      "webOrigins": [
        "http://localhost:3000"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:3000/*"
      },
      "defaultClientScopes": [
        "cashflow-claims",
        "entries:write",
        "entries:read",
        "balances:read",
        "assistant:draft"
      ],
      "optionalClientScopes": [
        "entries:audit",
        "balances:audit"
      ]
    },
    {
      "clientId": "merchant-integration",
      "name": "Machine-to-machine client of a merchant (client credentials, least privilege)",
      "enabled": true,
      "publicClient": false,
      "secret": "${MERCHANT_INTEGRATION_SECRET}",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "defaultClientScopes": [
        "cashflow-claims",
        "entries:write",
        "entries:read",
        "balances:read",
        "assistant:draft"
      ],
      "optionalClientScopes": []
    },
    {
      "clientId": "ops-admin",
      "name": "Operations client: can rebuild balances, nothing else",
      "enabled": true,
      "publicClient": false,
      "secret": "${OPS_ADMIN_SECRET}",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "defaultClientScopes": [
        "cashflow-claims",
        "balances:rebuild"
      ],
      "optionalClientScopes": []
    },
    {
      "clientId": "reconciler",
      "name": "Reconciliation job of the Consolidation service: reads totals, nothing else",
      "enabled": true,
      "publicClient": false,
      "secret": "${RECONCILER_SECRET}",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "defaultClientScopes": [
        "cashflow-claims",
        "entries:reconcile"
      ],
      "optionalClientScopes": []
    },
    {
      "clientId": "auditor-integration",
      "name": "Auditor tooling (client credentials): read-only, only the merchants assigned to it",
      "enabled": true,
      "publicClient": false,
      "secret": "${AUDITOR_SECRET}",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "defaultClientScopes": [
        "cashflow-claims",
        "entries:audit",
        "balances:audit"
      ],
      "optionalClientScopes": []
    }
  ],
  "users": [
    {
      "username": "service-account-merchant-integration",
      "enabled": true,
      "serviceAccountClientId": "merchant-integration",
      "attributes": {
        "merchant_id": [
          "11111111-1111-1111-1111-111111111111"
        ]
      }
    },
    {
      "username": "service-account-ops-admin",
      "enabled": true,
      "serviceAccountClientId": "ops-admin"
    },
    {
      "username": "merchant1",
      "enabled": true,
      "email": "merchant1@example.test",
      "emailVerified": true,
      "firstName": "Demo",
      "lastName": "Merchant",
      "attributes": {
        "merchant_id": [
          "11111111-1111-1111-1111-111111111111"
        ]
      },
      "credentials": [
        {
          "type": "password",
          "value": "${MERCHANT1_PASSWORD}",
          "temporary": false
        }
      ]
    },
    {
      "username": "service-account-reconciler",
      "enabled": true,
      "serviceAccountClientId": "reconciler"
    },
    {
      "username": "service-account-auditor-integration",
      "enabled": true,
      "serviceAccountClientId": "auditor-integration",
      "attributes": {
        "audit_merchants": [
          "11111111-1111-1111-1111-111111111111"
        ]
      }
    },
    {
      "username": "auditor1",
      "enabled": true,
      "email": "auditor1@example.test",
      "emailVerified": true,
      "firstName": "Demo",
      "lastName": "Auditor",
      "attributes": {
        "audit_merchants": [
          "11111111-1111-1111-1111-111111111111"
        ]
      },
      "credentials": [
        {
          "type": "password",
          "value": "${AUDITOR1_PASSWORD}",
          "temporary": false
        }
      ]
    }
  ]
}
